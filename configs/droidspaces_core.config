# Droidspaces core missing configs for Redmi Note 12 Pro 5G MT6877 kernel 4.19
# Base: original_boot.config extracted from stable boot.img

CONFIG_IPC_NS=y
CONFIG_DEVTMPFS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_DEVICE=y

# Recommended extra stability/compatibility for containers
CONFIG_CGROUP_PIDS=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_NET_PRIO=y

# NAT / network isolation helpers
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
